{
  "name": "cuttool",
  "version": "1.1.1",
  "description": "简约剪贴板历史管理器：全局监听、快捷键唤起、本地文件存储",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.12"
  },
  "build": {
    "appId": "com.xst.cuttool",
    "productName": "CutTool",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "resources/icon.png"
    }
  }
}
